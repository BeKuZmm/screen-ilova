<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 1. ASOSIY REJIM TANLASH OYNASI (MODE SELECTION) -->
    <LinearLayout
        android:id="@+id/layoutModeSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="visible">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ScreenShare"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#080E1A"
                android:background="@drawable/btn_gradient_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Tayyor"
                android:textColor="@color/accent_green"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qanday ulanmoqchisiz?"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kerakli rejimni tanlang:"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- KARTA 1: EKRANNI UZATISH -->
                <LinearLayout
                    android:id="@+id/cardCastScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_upload"
                            app:tint="@color/accent_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ekranni Uzatish"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefoningiz ekranini kompyuter yoki televizorga uzatish"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <!-- QR SKANER TUGMASI -->
                    <Button
                        android:id="@+id/btnScanQr"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="📷 QR-KODNI SKANERLASH"
                        android:textColor="#080E1A"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/btn_gradient_cyan"
                        android:layout_marginBottom="10dp" />

                    <!-- PIN BILAN ULASH -->
                    <Button
                        android:id="@+id/btnManualPin"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="⌨️ PIN kod orqali ulanish"
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp"
                        android:background="@drawable/btn_card_outline" />
                </LinearLayout>

                <!-- KARTA 2: EKRANNI QABUL QILISH -->
                <LinearLayout
                    android:id="@+id/cardReceiveScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="20dp"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/accent_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ekranni Qabul Qilish"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kompyuter yoki ikkinchi telefon ekranini ushbu telefonda ko'rish"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <!-- QABUL QILISH TUGMASI -->
                    <Button
                        android:id="@+id/btnOpenReceiver"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="📥 Qabul qilishni boshlash"
                        android:textColor="@color/accent_green"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/btn_card_outline" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 2. JONLI EFIR UZATILMOQDA OYNASI (STREAMING ACTIVE) -->
    <LinearLayout
        android:id="@+id/layoutStreamingActive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/stat_sys_upload"
            app:tint="@color/accent_cyan"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 EKRAN JONLI UZATILMOQDA"
            android:textColor="@color/accent_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStreamingTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kompyuter: 192.168.1.5:4848"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="36dp" />

        <Button
            android:id="@+id/btnStopStreaming"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🛑 EFIRNI TO'XTATISH"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/btn_danger_red" />
    </LinearLayout>

    <!-- 3. JONLI EFIR QABUL QILUVCHI OYNA (RECEIVER ACTIVE) -->
    <RelativeLayout
        android:id="@+id/layoutReceiverActive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- KADRLARNI KO'RSATUVCHI VIEW -->
        <ImageView
            android:id="@+id/ivReceivedScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- KUTISH XABARI -->
        <LinearLayout
            android:id="@+id/layoutReceiverWaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_cyan"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvWaitingStreamText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Efir kutilmoqda..."
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvReceiverPinHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIN: 777888"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- RECEIVER TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:background="#80000000"
            android:layout_alignParentTop="true">

            <ImageButton
                android:id="@+id/btnBackFromReceiver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:contentDescription="Chiqish" />

            <TextView
                android:id="@+id/tvReceiverDeviceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kompyuter ekrani"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
