<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C15">

    <!-- 1. ASOSIY REJIM OYNASI (HOME / MODE SELECTION) -->
    <LinearLayout
        android:id="@+id/layoutModeSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ScreenShare"
                    android:textColor="#F8FAFC"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textColor="#080C15"
                    android:background="@drawable/btn_gradient_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Wi-Fi Tayyor"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ASOSIY KARTA: EKRANNI KOMPYUTERGA UZATISH (PRIMARY) -->
                <LinearLayout
                    android:id="@+id/cardCastScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="22dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/stat_sys_upload"
                            app:tint="#00E5FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ekranni Uzatish (Cast)"
                            android:textColor="#F8FAFC"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefoningiz ekranini kompyuter yoki televizor monitoriga uzatish"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="20dp" />

                    <!-- KATTA ASOSIY QR SKANER TUGMASI -->
                    <Button
                        android:id="@+id/btnScanQr"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="📷  QR-KODNI SKANERLASH"
                        android:textColor="#080C15"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:background="@drawable/btn_gradient_cyan"
                        android:layout_marginBottom="12dp" />

                    <!-- 6 XONALI PIN ORQALI ULASH -->
                    <Button
                        android:id="@+id/btnManualPin"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="⌨️  6 xonali PIN kod orqali ulanish"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:background="@drawable/btn_card_outline" />
                </LinearLayout>

                <!-- IKKILAMCHI KARTA: EKRANNI QABUL QILISH -->
                <LinearLayout
                    android:id="@+id/cardReceiveScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="22dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#10B981" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ekranni Qabul Qilish"
                            android:textColor="#F8FAFC"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kompyuter yoki boshqa telefon ekranini ushbu telefonda ko'rish"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="18dp" />

                    <Button
                        android:id="@+id/btnOpenReceiver"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="📥  Qabul qilishni boshlash"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/btn_card_outline" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 2. JONLI EFIR UZATILMOQDA OYNASI (STREAMING ACTIVE) -->
    <LinearLayout
        android:id="@+id/layoutStreamingActive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@android:drawable/stat_sys_upload"
            app:tint="#00E5FF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴  JONLI EFIRDA"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStreamingTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kompyuterga uzatilmoqda..."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="36dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Telefoningiz ekranidagi barcha amallar hozir kompyuterda ko'rinmoqda. Ilovani fonga tushirib ishlatishingiz mumkin."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btnStopStreaming"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🛑  EFIRNI TO'XTATISH"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/btn_danger_red" />
    </LinearLayout>

    <!-- 3. JONLI EFIR QABUL QILUVCHI OYNA (RECEIVER VIEW) -->
    <RelativeLayout
        android:id="@+id/layoutReceiverActive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivReceivedScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/layoutReceiverWaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="#00E5FF"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvWaitingStreamText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kompyuter ekrani kutilmoqda..."
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TOP CONTROLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="#99000000"
            android:layout_alignParentTop="true">

            <ImageButton
                android:id="@+id/btnBackFromReceiver"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:contentDescription="Chiqish" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kompyuter ekrani"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
