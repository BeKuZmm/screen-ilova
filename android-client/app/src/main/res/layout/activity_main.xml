<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ScreenShare"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textColor="#080E1A"
                    android:background="@drawable/btn_gradient_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Wi-Fi: Qurilmalar qidirilmoqda..."
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQrScan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/card_bg"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/accent_cyan"
            android:contentDescription="QR Scan" />
    </LinearLayout>

    <!-- RADAR CONTAINER -->
    <FrameLayout
        android:id="@+id/radarContainer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/cardDiscovered"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Ring -->
        <View
            android:id="@+id/ringOuter"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/radar_ring" />

        <!-- Middle Ring -->
        <View
            android:id="@+id/ringMiddle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/radar_ring" />

        <!-- Inner Ring -->
        <View
            android:id="@+id/ringInner"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/radar_ring" />

        <!-- Center Phone Avatar -->
        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:background="@drawable/btn_gradient_cyan"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#080E1A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telefon"
                android:textColor="#080E1A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- DISCOVERED DEVICE CARD -->
    <LinearLayout
        android:id="@+id/cardDiscovered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/cardSettings">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOPILGAN QURILMA:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/ivDeviceIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@android:drawable/stat_notify_sync"
                app:tint="@color/accent_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kompyuter qidirilmoqda..."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi signali kutilmoqda"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeviceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avto"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#1A22C55E" />
        </LinearLayout>
    </LinearLayout>

    <!-- SETTINGS ROW (FPS / Quality) -->
    <LinearLayout
        android:id="@+id/cardSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_bg"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnToggleStream">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tasvir Sifati:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnQuality720"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="720p 30fps"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:padding="8dp"
            android:background="#1AFFFFFF" />

        <TextView
            android:id="@+id/btnQuality1080"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1080p 60fps"
            android:textColor="#080E1A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="@drawable/btn_gradient_cyan"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- ACTION BUTTON (START / STOP) -->
    <Button
        android:id="@+id/btnToggleStream"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn_gradient_cyan"
        android:text="🚀 EKRANNI UZATISHNI BOSHLASH"
        android:textColor="#080E1A"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
