{
  "name": "screen-share-pro",
  "version": "1.0.0",
  "description": "Universal Screen Sharing & Remote Mirroring App for PC, Phone, and TV",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.screenshare.pro",
    "productName": "ScreenShare PRO",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "screen-sharing",
    "webrtc",
    "screen-mirroring",
    "android",
    "tv",
    "windows"
  ],
  "author": "BeKuZmm",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.18.0"
  }
}
